{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.10.0"}
        compojure {:mvn/version "1.6.1"}
        ring/ring-defaults {:mvn/version "0.3.2"}
        ring/ring-json {:mvn/version "0.5.0"}
        info.sunng/ring-jetty9-adapter {:mvn/version "0.14.2"}
        org.clojure/data.json {:mvn/version "1.0.0"}
        org.clojure/core.async {:mvn/version "1.5.648"} ;; highest of the two
        ring-logger {:mvn/version "1.1.1"}
        ring-cors/ring-cors {:mvn/version "0.1.13"}
        bananaoomarang/ring-debug-logging {:mvn/version "1.1.0"}
        org.apache.logging.log4j/log4j-api {:mvn/version "2.14.0"}
        org.apache.logging.log4j/log4j-core {:mvn/version "2.14.0"}
        org.clojure/java.jdbc {:mvn/version "0.7.8"}
        org.postgresql/postgresql {:mvn/version "42.7.3"}
        yesql {:mvn/version "0.5.3"}
        environ {:mvn/version "1.2.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.36.0.3"}}

 :aliases
 {:dev
  {:jvm-opts ["-Dport=3000"
              "-Dclient-url=http://localhost:8080"]}

  :run
  {:main-opts ["-m" "amble-server.main"]}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.2.0"}
                cider/cider-nrepl {:mvn/version "0.49.0"}}
   :main-opts ["-e" "(require 'nrepl.cmdline) (apply nrepl.cmdline/-main [\"--middleware\" \"[cider.nrepl/cider-middleware]\" \"--host\" \"0.0.0.0\" \"--port\" \"7000\"])"]}

  :dbbackupapp
  {:paths ["src_dbbackup"]
   :deps {org.clojure/clojure {:mvn/version "1.10.0"}
          environ {:mvn/version "1.2.0"}
          clj-jgit/clj-jgit {:mvn/version "1.1.0"}
       ;;    org.eclipse.jgit/org.eclipse.jgit.ssh.apache {:mvn/version "6.7.0.202309050840-r"}}}
          org.apache.sshd/sshd-common {:mvn/version "3.0.0-M1"}}}
  ;;  :main-opts ["-m" "amble-shutdown.main"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
   :ns-default build}}}
