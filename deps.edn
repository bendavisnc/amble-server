{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        compojure {:mvn/version "1.7.2"}
        ring/ring-defaults {:mvn/version "0.7.1"}
        ring/ring-json {:mvn/version "0.5.1"}
        info.sunng/ring-jetty9-adapter {:mvn/version "0.40.1"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.clojure/core.async {:mvn/version "1.9.865"} ;; highest of the
                                                        ;; two
        ring-logger {:mvn/version "1.1.1"}
        ring-cors/ring-cors {:mvn/version "0.1.13"}
        bananaoomarang/ring-debug-logging {:mvn/version "1.1.0"}
        org.apache.logging.log4j/log4j-api {:mvn/version "2.26.1"}
        org.apache.logging.log4j/log4j-core {:mvn/version "2.26.1"}
        org.clojure/java.jdbc {:mvn/version "0.7.12"}
        org.postgresql/postgresql {:mvn/version "42.7.12"}
        ring/ring-mock {:mvn/version "0.6.2"}
        yesql {:mvn/version "0.5.4"}
        environ {:mvn/version "1.2.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.2.0"}}

 :aliases
 {:dev
  {:jvm-opts ["-Dport=3000"
              "-Dclient-url=http://localhost:8080"
              "-Dsqlite-db=amble-db/amble.db"]}
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test
         :jvm-opts    ["-Dsqlite-db=amble-db/amble.db"
                       "-Dclient-url=http://dummyclienturl:8080"]}


  :run
  {:main-opts ["-m" "amble-server.main"]}

  :nrepl
  {:extra-deps {nrepl/nrepl       {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.61.0"}}
   :main-opts
   ["-e"
    "(require 'nrepl.cmdline) (apply nrepl.cmdline/-main [\"--middleware\" \"[cider.nrepl/cider-middleware]\" \"--host\" \"0.0.0.0\" \"--port\" \"7000\"])"]}

  :dbbackupapp
  {:paths ["src_dbbackup"]
   :deps  {org.clojure/clojure {:mvn/version "1.12.5"}
           environ {:mvn/version "1.2.0"}
           clj-jgit/clj-jgit {:mvn/version "1.1.0"}
           ;;    org.eclipse.jgit/org.eclipse.jgit.ssh.apache {:mvn/version
           ;;    "6.7.0.202309050840-r"}}}
           org.apache.sshd/sshd-common {:mvn/version "3.0.0-M4"}}}
  ;;  :main-opts ["-m" "amble-shutdown.main"]}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}}}
