{:paths ["src" "resources"]

 :deps {org.clojure/clojure       {:mvn/version "1.12.5"}
        compojure/compojure       {:mvn/version "1.7.2"}
        ring/ring                 {:mvn/version "1.15.5"}
        ring/ring-json            {:mvn/version "0.5.1"}
        ring/ring-defaults        {:mvn/version "0.7.1"}
        org.clojure/data.json     {:mvn/version "2.5.2"}
        org.clojure/core.async    {:mvn/version "1.9.865"}
        ring-cors/ring-cors       {:mvn/version "0.1.13"}
        org.clojure/java.jdbc     {:mvn/version "0.7.12"}
        com.taoensso/timbre       {:mvn/version "6.8.0"}
        org.postgresql/postgresql {:mvn/version "42.7.13"}
        ring/ring-mock            {:mvn/version "0.6.2"}
        yesql/yesql               {:mvn/version "0.5.4"}
        environ/environ           {:mvn/version "1.2.0"}
        org.xerial/sqlite-jdbc    {:mvn/version "3.53.2.0"}}

 :aliases
 {:dev
  {:jvm-opts ["-Dport=3000"
              "-Dclient-url=http://localhost:8080"
              "-Dsqlite-db=amble-db/amble.db"
              "-Ddev-env=dev"]}
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test
         :jvm-opts    ["-Dport=dummynumber"
                       "-Dclient-url=http://dummyhost:8080"
                       "-Dsqlite-db=amble-db/amble.db"]}


  :run
  {:main-opts ["-m" "amble-server.main"]}

  :nrepl
  {:extra-deps {nrepl/nrepl       {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.62.0"}}
   :main-opts
   ["-e"
    "(require 'nrepl.cmdline) (apply nrepl.cmdline/-main [\"--middleware\" \"[cider.nrepl/cider-middleware]\" \"--host\" \"0.0.0.0\" \"--port\" \"7000\"])"]}

  :dbbackupapp
  {:paths ["src_dbbackup"]
   :deps  {org.clojure/clojure {:mvn/version "1.12.5"}
           environ/environ     {:mvn/version "1.2.0"}
           clj-jgit/clj-jgit   {:mvn/version "1.1.0"}
           org.apache.sshd/sshd-common {:mvn/version "3.0.0-M4"}}}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}}}
